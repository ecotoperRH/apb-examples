---
# ansible-lint configuration for jenkins_apb role
# Suppresses false positives from Kubernetes manifest fields inside definition: blocks

profile: moderate

skip_list:
  # jinja[type]: False positive — 'kind' and 'type' inside kubernetes.core.k8s definition:
  # blocks are Kubernetes manifest fields, not Jinja2 type expressions.
  # ansible-lint incorrectly flags bare words like 'Service', 'ClusterIP', 'Route' etc.
  - jinja[type]

warn_list:
  - yaml[indentation]

# yamllint configuration is in .yamllint in this directory
