---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: "{{ jenkins_service_name }}"
  namespace: "{{ namespace }}"
spec:
  rules:
    - host: "{{ ingress_hostname }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "{{ jenkins_service_name }}"
                port:
                  number: 80
